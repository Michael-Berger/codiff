#!/usr/bin/env bash
# Install or update this Codiff fork: build it, put the `codiff` CLI and the comment scripts on
# PATH, install the Claude Code skill, and point Codiff's commentCommand at codiff-comment so
# review comments reach the agent session that opened Codiff. Re-run it after `git pull` to update.
#
# Usage:
#   contrib/install-fork [--no-app] [--app-dir <dir>] [--bin-dir <dir>] [--check]
#
#   --check           Only check the prerequisites (Node, pnpm, a C++ compiler, Python) and exit.
#   --no-app          Run Codiff from this checkout instead of building Codiff.app. Changes take
#                     effect after `vpr build`, without reinstalling.
#   --app-dir <dir>   Where Codiff.app goes (default /Applications). macOS on Apple Silicon only.
#   --bin-dir <dir>   Where the CLI and scripts are linked (default ~/.local/bin).
#
# CODIFF_INSTALL_HOME replaces $HOME for everything the script installs (skill, config, default
# bin dir), so a trial run can stay out of the real home directory.

set -euo pipefail
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0

repo="$(CDPATH= cd -P "$(dirname "$0")/.." && pwd)"
install_home="${CODIFF_INSTALL_HOME:-$HOME}"
build_app=1
app_dir="/Applications"
bin_dir="$install_home/.local/bin"
check_only=0

die() { printf 'install-fork: %s\n' "$*" >&2; exit 1; }
step() { printf '\n==> %s\n' "$*"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --no-app)  build_app=0; shift ;;
    --app-dir) app_dir="$2"; shift 2 ;;
    --bin-dir) bin_dir="$2"; shift 2 ;;
    --check)   check_only=1; shift ;;
    -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
    *)         die "unknown argument: $1" ;;
  esac
done

tmp_dir="${TMPDIR:-/tmp}"
tmp_dir="${tmp_dir%/}"
log="$tmp_dir/codiff-install-fork.log"
exec > >(tee "$log") 2>&1
trap 'status=$?; [[ $status -eq 0 ]] || printf "\ninstall-fork failed. Full output: %s\n" "$log"' EXIT

required_major() {
  sed -n "s/.*\"$1\": *\">=\([0-9]*\).*/\1/p" "$repo/package.json" | head -1
}

step "Checking prerequisites"
problems=()
node_major="$(required_major node)"
pnpm_major="$(required_major pnpm)"

if ! command -v node >/dev/null; then
  problems+=("Node.js $node_major or newer is required (https://nodejs.org).")
elif node_version="$(node -p process.versions.node)" && (( ${node_version%%.*} < node_major )); then
  problems+=("Node.js $node_major or newer is required; found $node_version.")
fi

# Inside the repo, corepack runs the pnpm version pinned in package.json.
if ! command -v pnpm >/dev/null; then
  problems+=("pnpm is required: run \`corepack enable pnpm\`.")
elif ! pnpm_version="$(cd "$repo" && pnpm --version 2>/dev/null)"; then
  problems+=("pnpm did not run in $repo; run \`corepack enable pnpm\` and try again.")
elif (( ${pnpm_version%%.*} < pnpm_major )); then
  problems+=("pnpm $pnpm_major or newer is required; found $pnpm_version. Run \`corepack enable pnpm\` so the repo's pinned version is used.")
fi

# native-keymap has no prebuilt binary, and packaging recompiles native modules for Electron.
if [[ "$(uname -s)" == "Darwin" ]]; then
  if ! xcode-select -p >/dev/null 2>&1; then
    problems+=("Xcode Command Line Tools are required to compile native modules: run \`xcode-select --install\`.")
  elif ! compiler_error="$(printf 'int main() { return 0; }\n' |
    xcrun clang++ -x c++ - -o "$tmp_dir/codiff-install-fork-cc" 2>&1)"; then
    problems+=("The C++ compiler does not work, so native modules cannot be built:
$(printf '%s\n' "$compiler_error" | sed -n '1,5s/^/    /p')
  Usual fixes: \`sudo xcodebuild -license accept\` (full Xcode), \`sudo xcode-select --reset\`, or
  remove /Library/Developer/CommandLineTools and run \`xcode-select --install\` again after a macOS
  upgrade.")
  fi
elif ! command -v c++ >/dev/null || ! command -v make >/dev/null; then
  problems+=("A C++ compiler and make are required to compile native modules (for example build-essential).")
fi
rm -f "$tmp_dir/codiff-install-fork-cc"

python3 -c '' >/dev/null 2>&1 || problems+=("Python 3 is required to compile native modules.")

if [[ "$build_app" -eq 1 ]]; then
  [[ "$(uname -sm)" == "Darwin arm64" ]] ||
    problems+=("Codiff.app builds for macOS on Apple Silicon only; use --no-app elsewhere.")
fi

if (( ${#problems[@]} > 0 )); then
  printf 'Fix these, then re-run this script:\n' >&2
  printf -- '- %s\n' "${problems[@]}" >&2
  exit 1
fi
printf 'Node %s, pnpm %s, compiler and Python OK.\n' "$node_version" "$pnpm_version"
if command -v herdr >/dev/null && ! command -v jq >/dev/null; then
  printf 'Warning: herdr-comment needs jq to send comments to Herdr (brew install jq).\n'
fi
[[ "$check_only" -eq 0 ]] || exit 0

if [[ "$build_app" -eq 1 ]]; then
  if command -v brew >/dev/null && brew list --cask codiff >/dev/null 2>&1; then
    die "Upstream Codiff is installed with Homebrew and would replace this fork. Run \`brew uninstall --cask codiff\` (your settings are kept), then re-run this script."
  fi
  if pgrep -f "$app_dir/Codiff.app/Contents/MacOS/" >/dev/null; then
    die "Quit Codiff before installing."
  fi
fi

link() {
  local source="$1" target="$2"
  if [[ -e "$target" && ! -L "$target" ]]; then
    printf 'Skipped %s: it exists and is not a symlink.\n' "$target"
    return
  fi
  mkdir -p "$(dirname "$target")"
  ln -sfn "$source" "$target"
  printf 'Linked %s -> %s\n' "$target" "$source"
}

step "Installing dependencies"
pnpm --dir "$repo" install --frozen-lockfile

if [[ "$build_app" -eq 1 ]]; then
  step "Building Codiff.app"
  pnpm --dir "$repo" exec vpr build
  pnpm --dir "$repo" exec electron-forge package --platform=darwin --arch=arm64
  built_app="$repo/out/Codiff-darwin-arm64/Codiff.app"
  [[ -d "$built_app" ]] || die "the build did not produce $built_app."
  mkdir -p "$app_dir"
  rm -rf "$app_dir/Codiff.app"
  ditto "$built_app" "$app_dir/Codiff.app"
  rm -rf "$(dirname "$built_app")"
  # Packaging breaks Electron's signature, and Apple Silicon will not run an unsigned app.
  if [[ -z "${APPLE_SIGNING_IDENTITY:-}" ]]; then
    codesign --force --deep --sign - "$app_dir/Codiff.app"
  fi
  printf 'Installed %s\n' "$app_dir/Codiff.app"
  app_root="$app_dir/Codiff.app/Contents/Resources/app"
  cli="$app_root/bin/codiff-app"
else
  step "Building Codiff"
  pnpm --dir "$repo" exec vpr build
  app_root="$repo"
  cli="$repo/bin/codiff.js"
fi

step "Linking the CLI and comment scripts"
link "$cli" "$bin_dir/codiff"
link "$repo/contrib/codiff-comment" "$bin_dir/codiff-comment"
if command -v herdr >/dev/null; then
  link "$repo/contrib/herdr/herdr-comment" "$bin_dir/herdr-comment"
fi
case ":$PATH:" in
  *":$bin_dir:"*) ;;
  *) printf 'Add %s to your PATH to use these commands.\n' "$bin_dir" ;;
esac

step "Installing the Claude Code skill"
link "$app_root/claude/skills/codiff" "$install_home/.claude/skills/codiff"

step "Configuring review comments"
# Left by an upstream install's update check; the CLI wrapper would keep showing its notice.
rm -f "$install_home/.codiff/update-state.json"
HOME="$install_home" node - "$repo" <<'NODE'
const { copyFileSync, existsSync } = require('node:fs');
const repo = process.argv[2];
const { getConfigPath, readConfig, writeConfig } = require(`${repo}/electron/config.cjs`);
const commentCommand =
  'codiff-comment --target {target} --file {file} --path {path} --line {line} --end {endLine} --snippet {snippet} --send';
const config = readConfig();
const configPath = getConfigPath();
let next = config;
if (config.settings.commentCommand === commentCommand) {
  console.log(`${configPath} already sends comments with codiff-comment.`);
} else if (config.settings.commentCommand) {
  console.log(`Kept your commentCommand in ${configPath}. To use the fork's routing, set it to:`);
  console.log(`  ${commentCommand}`);
} else {
  next = { ...next, settings: { ...next.settings, commentCommand } };
  console.log(`Set commentCommand in ${configPath}.`);
}
// Upstream writes its defaults into the file, so a config still holding them gets the fork's.
if (config.keymap.askAgent === 'Mod+Alt+Enter' && config.keymap.submitComment === 'Mod+Enter') {
  next = {
    ...next,
    keymap: { ...next.keymap, askAgent: 'Mod+Enter', submitComment: 'Mod+Alt+Enter' },
  };
  console.log('Swapped the comment shortcuts: Mod+Enter asks, Mod+Alt+Enter comments.');
}
if (next !== config) {
  if (existsSync(configPath)) {
    copyFileSync(configPath, `${configPath}.bak`);
    console.log(`Backed up ${configPath} to ${configPath}.bak.`);
  }
  writeConfig(next);
}
NODE

step "Done"
printf 'Installed %s\n' "$("$bin_dir/codiff" --version)"
printf 'Run `codiff` in a repository, or ask Claude Code to "open this change in Codiff".\n'
